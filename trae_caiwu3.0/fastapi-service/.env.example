# Next.js 后端地址
NEXTJS_BASE_URL=http://localhost:3000

# FastAPI 监听（H-1: 生产环境用 127.0.0.1 + 反向代理）
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# hermes 服务账号（C-3: 请创建专用账号，不要用 admin，密码至少 16 位）
HERMES_USERNAME=<your-service-username>
HERMES_PASSWORD=<your-strong-password>

# C-1: hermes 调用 FastAPI 时需携带的 API Key（至少 32 位随机字符串）
# 生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_API_KEY=<your-api-key>

# C-2: 允许的 CORS 来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# H-2: 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# H-3: 导入文件大小限制（字节，默认 5MB）
MAX_IMPORT_FILE_SIZE=5242880

# 请求超时（秒）
REQUEST_TIMEOUT=30

# 调试模式（生产环境设为 false，会关闭 /docs）
DEBUG=true
